{
  "name": "dsh-purge",
  "version": "0.2.2",
  "description": "DeepSeek Harness 破甲插件：可换提示词、可换模型策略，内置红队演练台（预设 + 技能）。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./client.js",
    "./redteam": "./lib/redteam/index.js",
    "./redteam/store": "./lib/redteam/store.js",
    "./redteam/ui": "./lib/redteam/ui.js",
    "./redteam/tools": "./lib/redteam/tools.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-purge": "bin/dsh-purge.js"
  },
  "files": [
    "lib",
    "!lib/default-prompt-inject.md",
    "bin",
    "presets",
    "skills",
    "scripts",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test \"tests/**/*.test.mjs\"",
    "check": "node scripts/check-syntax.mjs && node scripts/build-client.mjs --check && node scripts/check-package.mjs && node scripts/check-market-index.mjs",
    "doctor": "node bin/dsh-purge.js --doctor",
    "embed-prompt": "node scripts/embed-default-prompt.mjs",
    "build:client": "node scripts/build-client.mjs"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-plugins",
    "网络安全",
    "红队评测",
    "llm-security",
    "harness-security",
    "deepseek-harness",
    "red-team",
    "instructions",
    "rules",
    "prompt-eval",
    "agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/y123546/dsh-clear.git"
  },
  "homepage": "https://github.com/y123546/dsh-clear#readme",
  "bugs": {
    "url": "https://github.com/y123546/dsh-clear/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "install": {
      "preferred": "tarball",
      "tarball": "https://github.com/y123546/dsh-clear/archive/refs/heads/main.tar.gz",
      "zip": "https://github.com/y123546/dsh-clear/archive/refs/heads/main.zip",
      "git": "https://github.com/y123546/dsh-clear.git"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dshTarget": ">=0.2.2"
}
